# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# .gitignore – SUPREMACY_SPX
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# ─── Node.js ──────────────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
package-lock.json
yarn.lock
pnpm-lock.yaml

# ─── Session & Database ──────────────────────
session/
sessions/
*.session/
creds.json
database.json
database_backup.json
*.db
*.sqlite

# ─── Environment & Secrets ──────────────────
.env
.env.local
.env.*.local
*.key
*.pem
*.crt

# ─── Logs ────────────────────────────────────
logs/
*.log
log.txt
error.log
debug.log

# ─── Temporary Files ────────────────────────
tmp/
temp/
*.tmp
*.temp
*.swp
*.swo

# ─── OS Files ──────────────────────────────
.DS_Store
Thumbs.db
*.thumbs.db
desktop.ini

# ─── Code Editors ───────────────────────────
.vscode/
.idea/
*.iml
.project
.classpath
.settings/

# ─── Build & Dist ───────────────────────────
dist/
build/
*.min.js
*.min.css

# ─── Tests ──────────────────────────────────
coverage/
.nyc_output/
test-results/

# ─── Misc ───────────────────────────────────
*.tgz
*.zip
*.rar
.DS_Store
